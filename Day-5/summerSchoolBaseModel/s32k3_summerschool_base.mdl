      <Object ObjectID="9" ClassName="Simulink.RTWCC">
        <P Name="SystemTargetFile" Class="char">ert.tlc</P>
        <P Name="HardwareBoard" Class="char">NXP S32K3xx</P>
        <P Name="TLCOptions" Class="char">-aInlineSetEventsForThisBaseRateFcn=TLC_FALSE -aSuppressMultiTaskScheduler=TLC_FALSE -aRateBasedStepFcn=1</P>
        <P Name="TemplateMakefile" Class="char">ert_default_tmf</P>
        <P Name="PostCodeGenCommand" Class="char">codertarget.postCodeGenHookCommand(h)</P>
        <P Name="GenerateReport" Class="char">on</P>
        <Array PropName="RTWBuildHooks" Type="Struct" Dimension="1*1">
          <MATStruct>
            <Field Name="className" Class="char">codertarget.tools.BuildHook</Field>
            <Array PropName="argsAllComponents" Type="Cell" Dimension="1*0"/>
            <Field Name="argsTopModelOnly" Class="double">[]</Field>
            <Field Name="excludedModels" Class="double">[]</Field>
            <Field Name="includeReferencedModels" Class="char">on</Field>
            <Field Name="includeTopModel" Class="char">on</Field>
            <Field Name="enabled" Class="char">on</Field>
          </MATStruct>
        </Array>
        <P Name="Toolchain" Class="char">S32DS GCC</P>
        <P Name="BuildConfiguration" Class="char">Specify</P>
        <Array PropName="CustomToolchainOptions" Type="Cell" Dimension="1*20">
          <Cell Class="char">Assembler</Cell>
          <Cell Class="char"> -c -x assembler-with-cpp -g -mcpu=cortex-m7 -mthumb -mlittle-endian -mfloat-abi=hard -mfpu=fpv5-sp-d16 -DD_CACHE_ENABLE -DI_CACHE_ENABLE $(EXTRA_ASFLAGS)</Cell>
          <Cell Class="char">C Compiler</Cell>
          <Cell Class="char">-O0 -c -std=c99 -fshort-enums -funsigned-char -fstack-usage -ffunction-sections -fdata-sections -g -pedantic -Wall -Wextra -fmessage-length=0 -funsigned-bitfields -fno-common -Wunused -Wstrict-prototypes -Wsign-compare -Werror=implicit-function-declaration -mcpu=cortex-m7 -mthumb -mlittle-endian -mfloat-abi=hard -mfpu=fpv5-sp-d16 -DD_CACHE_ENABLE -DI_CACHE_ENABLE</Cell>
          <Cell Class="char">Linker</Cell>
          <Cell Class="char"> -nostartfiles -Xlinker -Map=&quot;$(PRODUCT_NAME).map&quot; -Xlinker --gc-sections -n -mcpu=cortex-m7 -mthumb -mlittle-endian -mfloat-abi=hard -mfpu=fpv5-sp-d16</Cell>
          <Cell Class="char">Shared Library Linker</Cell>
          <Cell Class="char"> -nostartfiles -Xlinker -Map=&quot;$(PRODUCT_NAME).map&quot; -Xlinker --gc-sections -n -mcpu=cortex-m7 -mthumb -mlittle-endian -mfloat-abi=hard -mfpu=fpv5-sp-d16</Cell>
          <Cell Class="char">Archiver</Cell>
          <Cell Class="char"> -r</Cell>
          <Cell Class="char">Code Size</Cell>
          <Cell Class="char">--format=berkeley $(PRODUCT)</Cell>
          <Cell Class="char">ELF To Binary Converter</Cell>
          <Cell Class="char">-O binary $(PRODUCT) $(PRODUCT:.elf=.bin)</Cell>
          <Cell Class="char">Download</Cell>
          <Cell Class="char"/>
          <Cell Class="char">Execute</Cell>
          <Cell Class="char"/>
          <Cell Class="char">Make Tool</Cell>
          <Cell Class="char">-f $(MAKEFILE) -j</Cell>
        </Array>
        <P Name="IncludeHyperlinkInReport" Class="char">on</P>
        <P Name="LaunchReport" Class="char">on</P>
        <P Name="GenerateTraceInfo" Class="char">on</P>
        <P Name="GenerateTraceReport" Class="char">on</P>
        <P Name="GenerateTraceReportSl" Class="char">on</P>
        <P Name="GenerateTraceReportSf" Class="char">on</P>
